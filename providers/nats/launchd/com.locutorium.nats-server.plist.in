<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.locutorium.nats-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>@NATS_SERVER@</string>
    <string>-c</string>
    <string>@LOC_HOME@/nats-server.conf</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>@LOC_HOME@/server.log</string>
  <key>StandardErrorPath</key>
  <string>@LOC_HOME@/server.log</string>
</dict>
</plist>
