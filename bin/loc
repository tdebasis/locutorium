#!/usr/bin/env bash
# loc — the Locutorium CLI.
#
# In a silent house, the locutorium is the one room where speaking is allowed.
# Queues are one endpoint saying something to another; topics are the room
# where they converse. Nothing here is a record: what matters gets written
# down elsewhere, deliberately, by whoever it mattered to.

set -euo pipefail

# Find the house this loc belongs to by walking the symlink chain one hop at a
# time: readlink -f is not everywhere, and a relative target is relative to the
# link that named it, not to whoever is calling. A copied loc has no house and
# says so, instead of failing on a missing file three lines later.
_self="${BASH_SOURCE[0]}"; _hops=0
while [[ -L "$_self" ]]; do
  _t="$(readlink "$_self")"
  case "$_t" in
    /*) _self="$_t" ;;
    *)  _self="$(dirname "$_self")/$_t" ;;
  esac
  _hops=$((_hops + 1))
  if [[ $_hops -gt 40 ]]; then echo "loc: symlink loop while resolving $0" >&2; exit 1; fi
done
LOC_ROOT="$(cd "$(dirname "$_self")/.." && pwd -P)"
unset _self _hops _t
if [[ ! -f "$LOC_ROOT/lib/core.sh" ]]; then
  echo "loc: no lib/core.sh under $LOC_ROOT — this loc is a copy, not a link." >&2
  echo "     Clone the repository and run ./install.sh, which links loc into your PATH;" >&2
  echo "     never copy bin/loc out of its tree." >&2
  exit 1
fi
# shellcheck source=lib/core.sh
source "$LOC_ROOT/lib/core.sh"
loc_load_provider

usage() {
  cat <<'EOF'
usage: loc <verb> [args]

  send <endpoint> <body>    deliver to an endpoint's queue (guaranteed)
  publish <topic> <body>    speak in a topic (@name rings that endpoint)
  read [--peek]             your queue backlog + topic conversations
  sub [--watch-pid <pid>]   register attendance: start your wake listener
  unsub                     end attendance (the queue keeps holding messages)
  registry                  who is attending, read from the medium
  topics                    what conversations are active right now
  status                    unread counts per endpoint
  watch                     follow all traffic, read-only (^C to stop)
  doctor [--init]           health checks; --init creates streams (admin)
  version                   which loc this is
EOF
  exit 1
}

verb="${1:-}"; shift || true
case "$verb" in
  send)     [[ $# -ge 2 ]] || usage; loc_send "$1" "$2" ;;
  publish)  [[ $# -ge 2 ]] || usage; loc_publish "$1" "$2" ;;
  read)     loc_read "${1:-}" ;;
  sub)      loc_sub "$@" ;;
  unsub)    loc_unsub ;;
  registry) loc_registry ;;
  topics)   loc_topics ;;
  status)   loc_status ;;
  watch)    loc_watch ;;
  doctor)   loc_doctor "${1:-}" ;;
  version)  printf 'loc %s\n' "$(tr -d '[:space:]' < "$LOC_ROOT/VERSION")" ;;
  *)        usage ;;
esac
